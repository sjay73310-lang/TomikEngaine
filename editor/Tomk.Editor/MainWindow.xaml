<Window x:Class="Tomk.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tomk Engine Editor"
        Width="1360"
        Height="820"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ShowActivated="True"
        KeyDown="Window_KeyDown">
  <DockPanel LastChildFill="True">
    <Menu DockPanel.Dock="Top" Background="#181b20" Foreground="{StaticResource TextBrush}" BorderBrush="#3b424d">
      <MenuItem Header="_File">
        <MenuItem Header="Create New Project" Click="CreateNewProjectMenuItem_Click"/>
        <Separator/>
        <MenuItem Header="New Object" Click="NewObjectMenuItem_Click"/>
        <MenuItem Header="New Script" Click="NewScriptMenuItem_Click"/>
        <MenuItem Header="New Shader" Click="NewShaderMenuItem_Click"/>
        <MenuItem Header="New Material" Click="NewMaterialMenuItem_Click"/>
        <Separator/>
        <MenuItem Header="Save Scene" Click="SaveSceneButton_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Duplicate" Click="DuplicateButton_Click"/>
        <MenuItem Header="Delete Selected" Click="DeleteButton_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Frame Selected" Click="FrameSelectedMenuItem_Click"/>
        <MenuItem Header="Reset Camera" Click="ResetCameraMenuItem_Click"/>
      </MenuItem>
      <MenuItem Header="_Window">
        <MenuItem Header="Detach Hierarchy" Click="DetachHierarchyMenuItem_Click"/>
        <MenuItem Header="Detach Inspector" Click="DetachInspectorMenuItem_Click"/>
        <MenuItem Header="Detach Asset Browser" Click="DetachAssetsMenuItem_Click"/>
        <MenuItem Header="Detach Console" Click="DetachConsoleMenuItem_Click"/>
        <MenuItem Header="Detach Tomk Script" Click="DetachScriptMenuItem_Click"/>
        <Separator/>
        <MenuItem Header="Save Personal Layout" Click="SaveLayoutMenuItem_Click"/>
        <MenuItem Header="Load Personal Layout" Click="LoadLayoutMenuItem_Click"/>
        <MenuItem Header="Reset Window Layout" Click="ResetLayoutMenuItem_Click"/>
      </MenuItem>
      <MenuItem Header="_GameObject">
        <MenuItem Header="Camera" Click="AddCameraMenuItem_Click"/>
        <MenuItem Header="Directional Light" Click="AddDirectionalLightMenuItem_Click"/>
        <MenuItem Header="Point Light" Click="AddPointLightMenuItem_Click"/>
        <MenuItem Header="Game Settings" Click="AddGameSettingsMenuItem_Click"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#20242b" BorderBrush="#3b424d" BorderThickness="0,0,0,1" Height="48">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="240"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
          <TextBlock Text="TOMK" FontWeight="Bold" FontSize="18" Foreground="#4fb477" VerticalAlignment="Center"/>
          <TextBlock Text=" Engine" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Button x:Name="SelectToolButton" Content="Select" Click="SelectToolButton_Click"/>
          <Button x:Name="MoveToolButton" Content="Move" Click="MoveToolButton_Click"/>
          <Button x:Name="RotateToolButton" Content="Rotate" Click="RotateToolButton_Click"/>
          <Button x:Name="ScaleToolButton" Content="Scale" Click="ScaleToolButton_Click"/>
          <Button x:Name="GizmoToggleButton" Content="Gizmo On" Click="GizmoToggleButton_Click"/>
          <Button x:Name="PlayButton" Content="Play" Click="PlayButton_Click"/>
          <Button x:Name="PauseButton" Content="Pause" Click="PauseButton_Click"/>
          <Button Content="Save Scene" Click="SaveSceneButton_Click"/>
          <Button Content="Build Game" Click="BuildGameButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
          <TextBox x:Name="ProjectNameBox" Width="130" Height="28" Text="SampleFps" Margin="0,0,6,0"/>
          <Button Content="New Project" Click="CreateNewProjectButton_Click"/>
          <TextBlock x:Name="StatusText" Text="Editor ready" Foreground="#aeb6c2" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="WorkspaceGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="HierarchyColumn" Width="250" MinWidth="160"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="220"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5"/>
        <RowDefinition x:Name="BottomRow" Height="220" MinHeight="120"/>
      </Grid.RowDefinitions>

      <Border x:Name="HierarchyPanelHost" Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,1">
        <DockPanel Margin="10">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button Content="Float" DockPanel.Dock="Right" Padding="7,3" Click="DetachHierarchyMenuItem_Click"/>
            <TextBlock Text="Hierarchy" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+ Cube" Click="AddCubeButton_Click"/>
            <Button Content="+ Sphere" Click="AddSphereButton_Click"/>
            <Button Content="+ Plane" Click="AddPlaneButton_Click"/>
            <Button Content="+ Light" Click="AddPointLightMenuItem_Click"/>
          </StackPanel>
          <ListBox x:Name="HierarchyList"
                   DisplayMemberPath="Name"
                   SelectionChanged="HierarchyList_SelectionChanged"/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#303640"/>

      <Border Grid.Row="0" Grid.Column="2" Background="#111318" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,1,1">
        <TabControl x:Name="ViewTabs" Background="#0f1419">
          <TabItem Header="Scene View">
            <Grid x:Name="SceneViewSurface"
                  Background="#111318"
                  AllowDrop="True"
                  Focusable="True"
                  MouseDown="SceneViewSurface_MouseDown"
                  MouseMove="SceneViewSurface_MouseMove"
                  MouseUp="SceneViewSurface_MouseUp"
                  MouseWheel="SceneViewSurface_MouseWheel"
                  DragOver="SceneViewSurface_DragOver"
                  Drop="SceneViewSurface_Drop">
              <Viewport3D x:Name="SceneViewport"/>
              <Border Background="#aa15171b" BorderBrush="#3c424d" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
                <StackPanel>
                  <TextBlock x:Name="SceneHelpText" Text="Scene View  |  Left click: select/gizmo  |  Right drag: orbit  |  Middle drag: pan  |  Wheel: zoom" Foreground="#dce4ee"/>
                  <TextBlock x:Name="ToolHelpText" Text="Tool: Select  |  Gizmo On  |  W/E/R tools  |  WASD/QZ camera  |  Del delete" Foreground="#aeb6c2" Margin="0,3,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </TabItem>
          <TabItem Header="Game View">
            <Grid x:Name="GameViewSurface" Background="#050609">
              <Viewport3D x:Name="GameViewport"/>
              <Border Background="#aa15171b" BorderBrush="#3c424d" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
                <TextBlock x:Name="GameOverlayText" Text="Press Play to preview the scene" Foreground="#dce4ee"/>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>

      <GridSplitter Grid.Row="0" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#303640"/>

      <Border x:Name="InspectorPanelHost" Grid.Row="0" Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
        <DockPanel Margin="12">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Float" DockPanel.Dock="Right" Padding="7,3" Click="DetachInspectorMenuItem_Click"/>
            <TextBlock Text="Inspector" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          </DockPanel>

          <TabControl x:Name="InspectorTabs">
            <TabItem Header="Object">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">

            <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBox x:Name="NameBox" TextChanged="Inspector_TextChanged"/>

            <TextBlock Text="Type" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBox x:Name="TypeBox" IsReadOnly="True"/>

            <TextBlock Text="Transform Tool" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <UniformGrid Columns="4" Margin="0,0,0,10">
              <Button Content="Select" Click="SelectToolButton_Click"/>
              <Button Content="Move" Click="MoveToolButton_Click"/>
              <Button Content="Rotate" Click="RotateToolButton_Click"/>
              <Button Content="Scale" Click="ScaleToolButton_Click"/>
            </UniformGrid>

            <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <UniformGrid Columns="3">
              <TextBlock Text="X" Foreground="#df5959" HorizontalAlignment="Center"/>
              <TextBlock Text="Y" Foreground="#4fb477" HorizontalAlignment="Center"/>
              <TextBlock Text="Z" Foreground="#579de0" HorizontalAlignment="Center"/>
            </UniformGrid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PosXBox" Grid.Column="0" Margin="0,3,5,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
              <TextBox x:Name="PosYBox" Grid.Column="1" Margin="0,3,5,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
              <TextBox x:Name="PosZBox" Grid.Column="2" Margin="0,3,0,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
            </Grid>

            <TextBlock Text="Rotation" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <UniformGrid Columns="3">
              <TextBlock Text="X" Foreground="#df5959" HorizontalAlignment="Center"/>
              <TextBlock Text="Y" Foreground="#4fb477" HorizontalAlignment="Center"/>
              <TextBlock Text="Z" Foreground="#579de0" HorizontalAlignment="Center"/>
            </UniformGrid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="RotXBox" Grid.Column="0" Margin="0,3,5,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
              <TextBox x:Name="RotYBox" Grid.Column="1" Margin="0,3,5,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
              <TextBox x:Name="RotZBox" Grid.Column="2" Margin="0,3,0,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
            </Grid>

            <TextBlock Text="Scale" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <UniformGrid Columns="3">
              <TextBlock Text="X" Foreground="#df5959" HorizontalAlignment="Center"/>
              <TextBlock Text="Y" Foreground="#4fb477" HorizontalAlignment="Center"/>
              <TextBlock Text="Z" Foreground="#579de0" HorizontalAlignment="Center"/>
            </UniformGrid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ScaleXBox" Grid.Column="0" Margin="0,3,5,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
              <TextBox x:Name="ScaleYBox" Grid.Column="1" Margin="0,3,5,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
              <TextBox x:Name="ScaleZBox" Grid.Column="2" Margin="0,3,0,8" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
              <Button Content="Apply" Click="ApplyInspectorButton_Click"/>
              <Button Content="Duplicate" Click="DuplicateButton_Click"/>
              <Button Content="Delete" Click="DeleteButton_Click"/>
            </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Components">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                  <TextBlock Text="Object Components" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <ListBox x:Name="ComponentListBox" Height="120" Margin="0,0,0,8"/>
                  <TextBlock Text="Add Component" Foreground="{StaticResource MutedTextBrush}"/>
                  <ComboBox x:Name="AddComponentBox" Margin="0,3,0,8">
                    <ComboBoxItem Content="Mesh Renderer"/>
                    <ComboBoxItem Content="Collider"/>
                    <ComboBoxItem Content="Rigid Body"/>
                    <ComboBoxItem Content="Script Component"/>
                    <ComboBoxItem Content="FPS Controller"/>
                    <ComboBoxItem Content="Audio Source"/>
                    <ComboBoxItem Content="Particle Emitter"/>
                  </ComboBox>
                  <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Button Content="Add" Click="AddComponentButton_Click"/>
                    <Button Content="Remove" Click="RemoveComponentButton_Click"/>
                  </UniformGrid>
                  <TextBlock Text="Attach Script" Foreground="{StaticResource MutedTextBrush}"/>
                  <ComboBox x:Name="AttachScriptBox" Margin="0,3,0,8"/>
                  <Button Content="Attach Selected Script" Click="AttachScriptButton_Click"/>
                  <TextBlock Text="Component Notes" FontWeight="SemiBold" Margin="0,12,0,4"/>
                  <TextBox x:Name="ComponentNotesBox"
                           Height="120"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           Text="Transform, Mesh Renderer, Collider, Script Component"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Render">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
            <TextBlock Text="Material" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <ComboBox x:Name="ObjectMaterialBox" DisplayMemberPath="Name" SelectionChanged="ObjectMaterialBox_SelectionChanged" Margin="0,3,0,8"/>
            <UniformGrid Columns="2" Margin="0,0,0,8">
              <Button Content="New Material" Click="NewMaterialMenuItem_Click"/>
              <Button Content="Assign" Click="AssignMaterialButton_Click"/>
            </UniformGrid>

            <TextBlock Text="Selected Material Shader" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="MaterialShaderBox" DisplayMemberPath="Name" SelectionChanged="MaterialShaderBox_SelectionChanged" Margin="0,3,0,8"/>
            <UniformGrid Columns="2" Margin="0,0,0,12">
              <Button Content="New Shader" Click="NewShaderMenuItem_Click"/>
              <Button Content="Save Material" Click="SaveMaterialButton_Click"/>
            </UniformGrid>
                  <TextBlock Text="Mesh Renderer" FontWeight="SemiBold" Margin="0,10,0,4"/>
                  <CheckBox x:Name="MeshRendererEnabledBox" Content="Enabled" IsChecked="True" Checked="RendererToggle_Changed" Unchecked="RendererToggle_Changed"/>
                  <TextBlock Text="Only render properties are shown here. Transform stays in Object tab." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Camera">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
                  <TextBlock Text="Camera Component" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <CheckBox x:Name="CameraEnabledBox" Content="Enabled" IsChecked="True" Checked="CameraToggle_Changed" Unchecked="CameraToggle_Changed" Margin="0,0,0,8"/>
                  <TextBlock Text="Field Of View" Foreground="{StaticResource MutedTextBrush}"/>
                  <TextBox x:Name="CameraFovBox" Text="62" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
                  <TextBlock Text="Near Clip" Foreground="{StaticResource MutedTextBrush}"/>
                  <TextBox x:Name="CameraNearBox" Text="0.1" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
                  <TextBlock Text="Far Clip" Foreground="{StaticResource MutedTextBrush}"/>
                  <TextBox x:Name="CameraFarBox" Text="100" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
                  <TextBlock Text="Aspect Ratio" Foreground="{StaticResource MutedTextBrush}"/>
                  <TextBox x:Name="CameraAspectBox" Text="1.777" TextChanged="Inspector_TextChanged" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
                  <CheckBox x:Name="CameraFrustumBox" Content="Show Frustum Gizmo" IsChecked="True" Checked="CameraToggle_Changed" Unchecked="CameraToggle_Changed" Margin="0,4,0,8"/>
                  <Button Content="Apply Camera" Click="ApplyInspectorButton_Click"/>
                  <TextBlock Text="Select a Camera object in the Hierarchy to edit these values. The yellow frustum shows what the camera can see." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Lighting">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4">
            <TextBlock Text="Lighting" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <CheckBox x:Name="LightingEnabledBox" Content="Enable Scene Lighting" IsChecked="True" Checked="LightingToggle_Changed" Unchecked="LightingToggle_Changed" Margin="0,0,0,8"/>
            <CheckBox x:Name="SkyEnabledBox" Content="Enable Sky" IsChecked="True" Checked="LightingToggle_Changed" Unchecked="LightingToggle_Changed" Margin="0,0,0,8"/>
            <TextBlock Text="Sky" FontWeight="SemiBold" Margin="0,6,0,4"/>
            <ComboBox x:Name="SkyModeBox" SelectionChanged="SkyModeBox_SelectionChanged" Margin="0,3,0,8">
              <ComboBoxItem Content="Classic Skybox"/>
              <ComboBoxItem Content="Volumetric Sky"/>
            </ComboBox>
            <TextBlock Text="Sky Color" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBox x:Name="SkyColorBox" Text="#4f86c6"/>
            <TextBlock Text="Horizon Color" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBox x:Name="HorizonColorBox" Text="#d7edf5"/>
            <TextBlock Text="Cloud Density" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBox x:Name="CloudDensityBox" Text="0.45" PreviewMouseLeftButtonDown="NumericBox_MouseLeftButtonDown" PreviewMouseMove="NumericBox_MouseMove" PreviewMouseLeftButtonUp="NumericBox_MouseLeftButtonUp"/>
            <Button Content="Apply Sky" Click="ApplySkyButton_Click" Margin="0,0,0,12"/>
                  <TextBlock Text="Light objects can be added from GameObject menu or the Hierarchy + Light button." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#303640"/>

      <Border x:Name="BottomPanelHost" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Background="#1b1e24" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0">
        <TabControl x:Name="BottomTabs">
          <TabItem x:Name="AssetsTab" Header="Assets">
            <Grid x:Name="AssetBrowserRoot" Margin="10">
              <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AssetTreeColumn" Width="300" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <DockPanel Grid.ColumnSpan="3" LastChildFill="True">
                <TextBox x:Name="AssetSearchBox"
                         Width="240"
                         DockPanel.Dock="Left"
                         TextChanged="AssetSearchBox_TextChanged"
                         ToolTip="Search project assets"
                         Text=""/>
                <ComboBox x:Name="AssetCategoryBox"
                          Width="150"
                          DockPanel.Dock="Left"
                          Margin="8,3,8,8"
                          SelectionChanged="AssetCategoryBox_SelectionChanged">
                  <ComboBoxItem Content="All"/>
                  <ComboBoxItem Content="Models"/>
                  <ComboBoxItem Content="Materials"/>
                  <ComboBoxItem Content="Shaders"/>
                  <ComboBoxItem Content="Textures"/>
                  <ComboBoxItem Content="Scripts"/>
                  <ComboBoxItem Content="Scenes"/>
                  <ComboBoxItem Content="Objects"/>
                  <ComboBoxItem Content="Audio"/>
                  <ComboBoxItem Content="Imports"/>
                </ComboBox>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Zoom" Foreground="#aeb6c2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <Slider x:Name="AssetZoomSlider" Width="120" Minimum="92" Maximum="180" Value="116" ValueChanged="AssetZoomSlider_ValueChanged"/>
                </StackPanel>
                <TextBlock x:Name="AssetPathText" Text="Project Assets" Foreground="#aeb6c2" VerticalAlignment="Center"/>
              </DockPanel>

              <TreeView x:Name="AssetTree"
                        Grid.Row="1"
                        Grid.Column="0"
                        SelectedItemChanged="AssetTree_SelectedItemChanged"
                        AllowDrop="True"
                        DragOver="AssetTree_DragOver"
                        Drop="AssetTree_Drop"
                        Background="#15181d"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="#3c424d">
                <TreeView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Add To Scene" Click="AddSelectedAssetToSceneMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Import Model" Click="ImportModelMenuItem_Click"/>
                    <MenuItem Header="Import Texture" Click="ImportTextureMenuItem_Click"/>
                    <MenuItem Header="New Shader" Click="NewShaderMenuItem_Click"/>
                    <MenuItem Header="New Material" Click="NewMaterialMenuItem_Click"/>
                    <MenuItem Header="New Object File" Click="NewObjectMenuItem_Click"/>
                    <MenuItem Header="New Script" Click="NewScriptMenuItem_Click"/>
                    <MenuItem Header="New Folder" Click="CreateAssetFolderMenuItem_Click"/>
                    <Separator/>
                    <MenuItem Header="Reveal In Explorer" Click="RevealAssetMenuItem_Click"/>
                    <MenuItem Header="Refresh" Click="RefreshProjectFilesButton_Click"/>
                  </ContextMenu>
                </TreeView.ContextMenu>
              </TreeView>

              <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#303b49"/>

              <DockPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                  <Button Content="Import Model" Click="ImportModelMenuItem_Click"/>
                  <Button Content="Import Texture" Click="ImportTextureMenuItem_Click"/>
                  <Button Content="+ Shader" Click="NewShaderMenuItem_Click"/>
                  <Button Content="+ Material" Click="NewMaterialMenuItem_Click"/>
                  <Button Content="+ Script" Click="NewScriptMenuItem_Click"/>
                  <Button Content="Save Scene" Click="SaveSceneButton_Click"/>
                  <Button Content="Refresh" Click="RefreshProjectFilesButton_Click"/>
                </WrapPanel>

                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="110"/>
                  </Grid.RowDefinitions>

                  <ListBox x:Name="AssetItemsList"
                           Grid.Row="0"
                           SelectionChanged="AssetItemsList_SelectionChanged"
                           MouseDoubleClick="AssetItemsList_MouseDoubleClick"
                           AllowDrop="True"
                           DragOver="AssetTree_DragOver"
                           Drop="AssetTree_Drop"
                           Background="#101216"
                           BorderBrush="#3c424d"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border Width="{Binding Value, ElementName=AssetZoomSlider}" Height="{Binding Value, ElementName=AssetZoomSlider}" Background="#18202a" BorderBrush="#334153" BorderThickness="1" Margin="5" Padding="7">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center" Foreground="#f2c94c"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" Foreground="#eef2f7" Margin="0,7,0,0"/>
                            <TextBlock Text="{Binding Category}" TextAlignment="Center" Foreground="#8f9bad" FontSize="11"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Add To Scene" Click="AddSelectedAssetToSceneMenuItem_Click"/>
                        <MenuItem Header="Reveal In Explorer" Click="RevealAssetMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Import Model" Click="ImportModelMenuItem_Click"/>
                        <MenuItem Header="Import Texture" Click="ImportTextureMenuItem_Click"/>
                        <MenuItem Header="New Shader" Click="NewShaderMenuItem_Click"/>
                        <MenuItem Header="New Material" Click="NewMaterialMenuItem_Click"/>
                      </ContextMenu>
                    </ListBox.ContextMenu>
                  </ListBox>

                  <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#303b49"/>

                <Border Grid.Row="2" Background="#101216" BorderBrush="#3c424d" BorderThickness="1" Padding="10">
                  <StackPanel>
                    <TextBlock x:Name="AssetPreviewTitle" Text="Asset Inspector" FontWeight="SemiBold" Foreground="#eef2f7"/>
                    <TextBlock x:Name="AssetPreviewKind" Text="Select any project file" Foreground="#aeb6c2" Margin="0,4,0,0"/>
                    <TextBlock x:Name="AssetPreviewPath" Text="" Foreground="#7f8b9a" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="Right-click assets to import, create, reveal, or add supported files to the scene." Foreground="#aeb6c2" TextWrapping="Wrap" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
                </Grid>
              </DockPanel>
            </Grid>
          </TabItem>
          <TabItem x:Name="ConsoleTab" Header="Console">
            <TextBox x:Name="ConsoleBox"
                     Background="#101216"
                     BorderThickness="0"
                     Foreground="#dce4ee"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"/>
          </TabItem>
          <TabItem x:Name="ScriptTab" Header="Tomk Script">
            <TextBox x:Name="ScriptBox"
                     Background="#101216"
                     BorderThickness="0"
                     Foreground="#e7edf5"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="14"/>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
