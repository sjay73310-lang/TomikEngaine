<Application x:Class="Tomk.Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#202329"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#2a2e36"/>
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#3c424d"/>
    <SolidColorBrush x:Key="TextBrush" Color="#eef2f7"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#aeb6c2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4fb477"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="#17191e"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#303640"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="#46505d"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#15171b"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="#46505d"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Margin" Value="0,3,0,8"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#1c1f25"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="#3c424d"/>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#17191e"/>
      <Setter Property="BorderBrush" Value="#3c424d"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#252a32"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="12,6"/>
    </Style>
  </Application.Resources>
</Application>
